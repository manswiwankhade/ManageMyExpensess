<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8EF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtBackIncome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹  Back"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#625B83"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Add Income"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#514B70"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Record money you received"
            android:textSize="15sp"
            android:textColor="#8B8494"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Amount"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#514B70"/>

        <EditText
            android:id="@+id/edtIncomeAmount"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:hint="₹ 0.00"
            android:inputType="numberDecimal"
            android:textSize="18sp"
            android:padding="15dp"
            android:background="@drawable/edittext_background"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Income Category"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#514B70"/>

        <Spinner
            android:id="@+id/spinnerIncomeCategory"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edittext_background"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Date"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#514B70"/>

        <EditText
            android:id="@+id/edtIncomeDate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:hint="Select date"
            android:focusable="false"
            android:clickable="true"
            android:padding="15dp"
            android:background="@drawable/edittext_background"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Payment Method"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#514B70"/>

        <Spinner
            android:id="@+id/spinnerIncomePayment"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/edittext_background"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Note (Optional)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#514B70"/>

        <EditText
            android:id="@+id/edtIncomeNote"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="8dp"
            android:hint="Add a note..."
            android:gravity="top"
            android:inputType="textMultiLine"
            android:padding="15dp"
            android:background="@drawable/edittext_background"/>

        <Button
            android:id="@+id/btnSaveIncome"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="25dp"
            android:text="Save Income"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#625B83"/>

    </LinearLayout>

</ScrollView>