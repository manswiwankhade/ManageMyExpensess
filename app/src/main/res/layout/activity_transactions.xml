<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8EF"
    android:padding="24dp">

    <!-- Header -->

    <TextView
        android:id="@+id/txtBackTransactions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="‹  Back"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#625B83"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Transactions"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#514B70"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Your complete income and expense history"
        android:textSize="14sp"
        android:textColor="#8B8494"/>


    <!-- Filter buttons -->

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAll"
                android:layout_width="95dp"
                android:layout_height="45dp"
                android:text="All"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#625B83"/>

            <Button
                android:id="@+id/btnIncomeFilter"
                android:layout_width="110dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:backgroundTint="#E8E2F2"
                android:text="Income"
                android:textColor="#625B83"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnExpenseFilter"
                android:layout_width="110dp"
                android:layout_height="45dp"
                android:layout_marginStart="8dp"
                android:text="Expenses"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#625B83"
                android:backgroundTint="#E8E2F2"/>

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Transaction list -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerTransactions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="15dp"
        android:clipToPadding="false"
        android:paddingBottom="10dp"/>

</LinearLayout>