<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8EF">

    <!-- ================================================= -->
    <!-- MAIN CONTENT -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="25dp">

                <!-- ================= HEADER ================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtGreeting"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Good morning 👋"
                            android:textSize="14sp"
                            android:textColor="#8B8494"/>

                        <TextView
                            android:id="@+id/txtUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="User"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="#514B70"/>

                    </LinearLayout>

                    <!-- Small calculator shortcut -->

                    <ImageView
                        android:id="@+id/btnCalculator"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="12dp"
                        android:padding="8dp"
                        android:src="@drawable/ic_calculator"
                        android:background="@drawable/calculator_button"
                        android:scaleType="centerInside"
                        android:contentDescription="Calculator"
                        android:clickable="true"
                        android:focusable="true"
                        android:elevation="6dp" />
                </LinearLayout>


                <!-- ================= BALANCE ================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:padding="21dp"
                    android:background="@drawable/balance_card"
                    android:elevation="3dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available Balance"
                        android:textSize="13sp"
                        android:textColor="#EDEAF5"/>

                    <TextView
                        android:id="@+id/txtBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="₹ 0.00"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:alpha="0.25"
                        android:background="#FFFFFF"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="↑ Income"
                                android:textSize="12sp"
                                android:textColor="#EDEAF5"/>

                            <TextView
                                android:id="@+id/txtIncome"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="₹ 0.00"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="↓ Expenses"
                                android:textSize="12sp"
                                android:textColor="#EDEAF5"/>

                            <TextView
                                android:id="@+id/txtExpense"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="₹ 0.00"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>


                <!-- ================= THIS MONTH ================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="This Month"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="#514B70"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#625B83"/>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:padding="17dp"
                    android:background="@drawable/rounded_white"
                    android:elevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/txtMonthSpent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="₹ 0.00 spent"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#514B70"/>

                        <TextView
                            android:id="@+id/txtMonthPercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#625B83"/>

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/monthProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="9dp"
                        android:layout_marginTop="13dp"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#625B83"
                        android:backgroundTint="#E6E1EF"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="Your spending for the current month"
                        android:textSize="11sp"
                        android:textColor="#8B8494"/>

                </LinearLayout>


                <!-- ================= QUICK ACTIONS ================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="23dp"
                    android:text="Quick Actions"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#514B70"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAddExpense"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:text="+ Add Expense"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#625B83"/>

                    <Button
                        android:id="@+id/btnAddIncome"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:text="+ Add Income"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#625B83"
                        android:backgroundTint="#E6E1EF"/>

                </LinearLayout>


                <!-- ================= RECENT TRANSACTIONS ================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recent Transactions"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:textColor="#514B70"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Your latest money activity"
                            android:textSize="11sp"
                            android:textColor="#8B8494"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtSeeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="See All →"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#625B83"/>

                </LinearLayout>


                <!-- TRANSACTION CARD -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="vertical"
                    android:padding="7dp"
                    android:background="@drawable/rounded_white"
                    android:elevation="2dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerRecentTransactions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"/>

                </LinearLayout>


                <!-- ================= SMART INSIGHT ================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Smart Insight"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#514B70"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:background="@drawable/insight_card"
                    android:elevation="1dp">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:text="✦"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#625B83"
                        android:background="#E6E1EF"/>

                    <TextView
                        android:id="@+id/txtInsight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:text="Add some expenses to receive a personalized spending insight."
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#6E6878"/>

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="20dp"/>

            </LinearLayout>

        </ScrollView>


        <!-- ================= BOTTOM NAVIGATION ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#F0ECF7"
            android:elevation="8dp">

            <TextView
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="🏠&#10;Home"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#625B83"/>

            <TextView
                android:id="@+id/navAnalytics"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="📊&#10;Analytics"
                android:textSize="12sp"
                android:textColor="#8B8494"/>

            <TextView
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="👤&#10;Profile"
                android:textSize="12sp"
                android:textColor="#8B8494"/>

        </LinearLayout>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- FLOATING CALCULATOR -->
    <!-- ================================================= -->



</FrameLayout>