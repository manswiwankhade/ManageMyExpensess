<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8EF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================= HEADER ================= -->

        <TextView
            android:id="@+id/txtBackDetailed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹  Back"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#625B83"
            android:padding="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Spending Analytics"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#514B70"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Understand your spending habits and patterns"
            android:textSize="14sp"
            android:textColor="#8B8494"/>


        <!-- ================= TOTAL CARD ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/balance_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL SPENDING"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#E8E3F0"/>

            <TextView
                android:id="@+id/txtTotalExpense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Total Spending   ₹0.00"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

        </LinearLayout>


        <!-- ================= CATEGORY TITLE ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Spending by Category"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#514B70"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="See where most of your money is being spent"
            android:textSize="13sp"
            android:textColor="#8B8494"/>


        <!-- ================= CATEGORY DETAILS ================= -->

        <LinearLayout
            android:id="@+id/layoutCategoryDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/rounded_white">

        </LinearLayout>


        <!-- ================= PIE CHART BUTTON ================= -->

        <TextView
            android:id="@+id/btnPieChart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="16dp"
            android:gravity="center"
            android:text="◉  View Category Distribution"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#514B70"
            android:background="@drawable/rounded_white"/>


        <!-- ================= BAR CHART BUTTON ================= -->

        <TextView
            android:id="@+id/btnBarChart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="16dp"
            android:gravity="center"
            android:text="▥  View Monthly Spending"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#514B70"
            android:background="@drawable/rounded_white"/>


        <!-- ================= SMART INSIGHT ================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Smart Insight"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#514B70"/>

        <LinearLayout
            android:id="@+id/layoutSmartInsight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/rounded_white">

            <TextView
                android:id="@+id/txtSmartInsight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your spending insight will appear here."
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:textColor="#514B70"/>

        </LinearLayout>


        <!-- ================= BOTTOM SPACE ================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="35dp"/>

    </LinearLayout>

</ScrollView>